# =============================================================================
# LibreChat + Memory Palace Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Server host and port
HOST=localhost
PORT=3080

# Environment (production, development)
NODE_ENV=production

# =============================================================================
# ANTHROPIC CONFIGURATION (REQUIRED)
# =============================================================================

# Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Models to expose in the UI (comma-separated)
# Available models: claude-sonnet-4-20250514, claude-opus-4-0-20250514, claude-haiku-4-0-20250514
ANTHROPIC_MODELS=claude-sonnet-4-20250514,claude-opus-4-0-20250514

# =============================================================================
# SECURITY KEYS (REQUIRED)
# =============================================================================
# Generate these with: openssl rand -hex 32 (for 32-char keys)
#                      openssl rand -hex 16 (for 16-char keys)

# Encryption key for credentials (32 hex characters)
CREDS_KEY=

# Encryption IV (16 hex characters)
CREDS_IV=

# JWT secret for authentication (any strong random string)
JWT_SECRET=

# JWT refresh token secret (any strong random string)
JWT_REFRESH_SECRET=

# =============================================================================
# MEMORY PALACE CONFIGURATION
# =============================================================================

# Path to your memory palace MCP server installation
# This directory should contain the Python package with run_stdio.py
MEMORY_PALACE_PATH=/path/to/your/memory_palace

# Directory for memory palace data (ChromaDB, SQLite, etc.)
# Will be created if it doesn't exist
MEMORY_PALACE_DATA=./data/memory_palace

# =============================================================================
# OPTIONAL: OTHER AI PROVIDERS
# =============================================================================
# Leave empty to disable

# OpenAI
OPENAI_API_KEY=

# Google (Gemini)
GOOGLE_KEY=

# Azure OpenAI
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=

# =============================================================================
# OPTIONAL: RAG (Vector Search) CONFIGURATION
# =============================================================================

# Embeddings provider for RAG (huggingface, openai)
RAG_EMBEDDINGS_PROVIDER=huggingface

# HuggingFace token (optional, for gated models)
HF_TOKEN=

# Chunk settings for document processing
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=100

# =============================================================================
# OPTIONAL: DEBUG & LOGGING
# =============================================================================

# Enable debug logging
DEBUG_LOGGING=false
DEBUG_CONSOLE=false

# =============================================================================
# OPTIONAL: REGISTRATION & AUTH
# =============================================================================

# Allow new user registration (true/false)
ALLOW_REGISTRATION=true

# Allow social logins (comma-separated: google,github,discord,openid)
ALLOW_SOCIAL_LOGIN=

# Domain whitelist for registration (comma-separated)
DOMAIN_WHITELIST=

# =============================================================================
# MONITORING & METRICS CONFIGURATION
# =============================================================================

# Enable Prometheus metrics in Memory Palace
METRICS_ENABLED=true

# Memory Palace ports
MEMORY_PALACE_API_PORT=8000
MEMORY_PALACE_MCP_PORT=8765

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
# Enable anonymous access for read-only dashboards
GRAFANA_ANONYMOUS_ENABLED=false

# Prometheus Configuration
PROMETHEUS_PORT=9090

# AlertManager Configuration
ALERTMANAGER_PORT=9093
